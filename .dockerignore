# A host-built node_modules (e.g. sharp's native binary) must not leak into the
# Alpine image. .env is deliberately NOT ignored: Vite bakes any VITE_* keys
# into the bundle at build time.
node_modules
dist
dist-ssr
.git
# No full-size image originals to exclude: scripts/convert-images.mjs replaces
# them with .webp in public/images, which is what the build uses.

# Editor/system
.vscode
.idea
.DS_Store
coverage
.cache
npm-debug.log*
